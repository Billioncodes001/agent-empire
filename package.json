{
  "name": "agent-empire",
  "version": "0.1.0",
  "description": "A persistent agent-powered office and founding city district",
  "type": "module",
  "bin": {
    "agent-office": "bin/agent-office.js",
    "agent-empire": "bin/agent-office.js",
    "agent-empire-sync": "bin/agent-empire-sync.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/cli.ts --port 4600 --password dev\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:cloud": "vite build --config vite.cloud.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.cloud.json --noEmit",
    "start": "node bin/agent-office.js",
    "prepare": "npm run build",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "desktop:prepare": "npm run build && node tools/prepare-desktop.mjs",
    "desktop": "npm run desktop:prepare && npm start --prefix desktop",
    "desktop:package": "npm run desktop:prepare && npm run package --prefix desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
