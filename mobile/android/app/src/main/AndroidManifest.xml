<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.agentempire.mobile" android:versionCode="10000301" android:versionName="1.0.0-beta.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app updates of a sideloaded app: the downloaded APK (sha256-checked against the signed channel) is handed to
         the system installer, which asks the player. Play installs never use it; they open the Play listing. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- The bundled game is served from APK assets at https://appassets.androidplatform.net (no server page is loaded).
         Cloud backup and device transfer are off; cleartext is off (the debug build alone allows local test hosts). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/GameTheme"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- App-update install status from PackageInstaller only (explicit, non-exported, nonce-checked). -->
        <receiver android:name=".InstallStatusReceiver" android:exported="false" />
    </application>
</manifest>
